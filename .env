

# Connexion MongoDB Atlas
MONGODB_URI=mongodb+srv://jezeryshop-app:Djamalexandra8076.@cluster0.c7kfu9c.mongodb.net/jezeryshop?retryWrites=true&w=majority

# Secret utilisé pour signer les jetons de connexion admin (JWT).
# Générez une valeur aléatoire longue, par exemple avec :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_moi_avec_une_valeur_aleatoire_longue

# Identifiants admin (un seul compte, celui de Djamal)
ADMIN_EMAIL=djamal@example.com
# Hash bcrypt du mot de passe admin — ne JAMAIS mettre le mot de passe en clair ici.
# Générez-le avec le script scripts/hashPassword.js (voir README).
ADMIN_PASSWORD_HASH=

# Origine autorisée pour les requêtes CORS (votre site déployé sur Vercel)
ALLOWED_ORIGIN=http://localhost:5173

# Port du serveur
PORT=4000

# Configuration SMTP pour l'envoi d'e-mails de notification
# Exemple avec Brevo (ex-Sendinblue), qui offre un plan gratuit fiable
# pour l'envoi transactionnel (contrairement à Gmail SMTP, à éviter en prod).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre_identifiant_smtp
SMTP_PASSWORD=votre_cle_smtp
NOTIFY_EMAIL=djamal@example.com
FROM_EMAIL="Jezeryshop <notifications@jezeryshop.dz>"
